FROM python:3.13-slim

WORKDIR /app

# Konteks build adalah root monorepo (lihat docker-compose.yml).
COPY pyproject.toml ./
COPY apps/api ./apps/api
COPY packages/database ./packages/database

RUN pip install --no-cache-dir \
    "fastapi>=0.115" "uvicorn[standard]>=0.30" "sqlalchemy>=2.0.36" \
    "alembic>=1.13" "pydantic>=2.12" "psycopg[binary]>=3.2"

ENV PYTHONPATH=/app/apps/api
ENV DEXTRA_ROOT=/app
ENV DEXTRA_DATA_DIR=/app/data
EXPOSE 8000

# Migrasi dijalankan saat start supaya container tidak pernah melayani skema basi.
CMD ["sh", "-c", "alembic -c packages/database/alembic.ini upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]

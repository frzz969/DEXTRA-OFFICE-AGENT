FROM node:22-slim

# Repo ini memakai pnpm. Corepack membaca `packageManager` dari package.json,
# jadi versi pnpm tidak ditulis dua kali di sini.
RUN corepack enable

WORKDIR /app

# Salin manifest seluruh workspace agar `pnpm install --frozen-lockfile` bisa
# memvalidasi importer di pnpm-lock.yaml.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY scripts ./scripts
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @dextra/web run build

EXPOSE 3000
CMD ["pnpm", "--filter", "@dextra/web", "run", "start"]

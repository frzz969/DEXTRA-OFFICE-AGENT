{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "DEXTRA_API_URL"
        }
      ]
    },
    "app": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "functions": {
    "apps/web/src/app/api/[...proxy]/route.ts": { "maxDuration": 60 }
  }
}

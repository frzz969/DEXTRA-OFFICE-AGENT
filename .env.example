# ---------- App ----------
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dextra

# ---------- Redis / Queue ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000

# ---------- AI Providers (provider-agnostic) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=

# ---------- Backend API (apps/api) ----------
# Default: SQLite di <repo>/data/dextra.db. PostgreSQL opsional (pasang extra
# `postgres`; psycopg tidak punya wheel untuk Termux/Android).
DATABASE_URL=sqlite+pysqlite:///./data/dextra.db
# DATABASE_URL=postgresql+psycopg://dextra:dextra@localhost:5432/dextra

# Root monorepo & direktori data runtime (SQLite, outbox .eml/.ics).
# Kosongkan untuk deteksi otomatis dari lokasi kode.
DEXTRA_ROOT=
DEXTRA_DATA_DIR=./data

DEXTRA_ENV=development
# Token gateway (ganti di production; default dev ditolak saat DEXTRA_ENV=production).
DEXTRA_AGENT_TOKEN=agent-dev-token
DEXTRA_OPS_TOKEN=ops-dev-token
# Token gateway hanya melihat tenant ini (hasil seed: dextra-demo).
DEXTRA_LEGACY_TENANT=dextra-demo
DEXTRA_ALLOWED_ORIGINS=http://127.0.0.1:8899,http://localhost:8899,http://127.0.0.1:3000,http://localhost:3000

# Seed demo: bila kosong, password acak dicetak sekali saat seed.
# DEXTRA_SEED_PASSWORD=

# Sesi manusia & MFA (opsional).
# DEXTRA_SESSION_COOKIE=dextra_session
# DEXTRA_CSRF_COOKIE=dextra_csrf
# DEXTRA_SESSION_ABSOLUTE_MINUTES=720
# DEXTRA_SESSION_IDLE_MINUTES=30
# DEXTRA_COOKIE_SECURE=false
# DEXTRA_MFA_ISSUER=DEXTRA
# DEXTRA_MFA_KEY=

# Google OAuth (opsional).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

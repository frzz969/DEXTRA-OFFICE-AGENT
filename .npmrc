# Android shared storage (/storage/emulated/0) is a FUSE mount that denies symlinks.
# Use a hoisted, copied node_modules layout so installs work without symlinks.
node-linker=hoisted
inject-workspace-packages=true
package-import-method=copy
strict-peer-dependencies=false
auto-install-peers=true
store-dir=/data/data/com.termux/files/home/.pnpm-store
